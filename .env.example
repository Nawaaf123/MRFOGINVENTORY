# Local / production environment values (copy to .env)
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["*"]
# Leave empty for Vite proxy during local frontend dev
VITE_API_URL=

# Manual deploy (used by ./scripts/deploy.sh)
# EC2_HOST=YOUR_EC2_PUBLIC_IP
# EC2_KEY=~/.ssh/your-key.pem
# EC2_USER=ubuntu
# APP_DIR=~/stock-keeper
